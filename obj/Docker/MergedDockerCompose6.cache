name: dockercompose11189548075144855321
services:
  shareddriveaccess:
    build:
      context: C:\Users\fhulufhelo\source\repos\SharedDriveAccess
      dockerfile: SharedDriveAccess/Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: SharedDriveAccess
      target: base
    container_name: SharedDriveAccess_1
    entrypoint:
      - tail
      - -f
      - /dev/null
    environment:
      NUGET_FALLBACK_PACKAGES: /.nuget/fallbackpackages
    image: shareddriveaccess:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  "/app/bin/Debug/net8.0/SharedDriveAccess.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: /bin/sh -c "if PID=$$(pidof dotnet); then kill $$PID; fi"
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      default: null
    tty: true
    volumes:
      - type: volume
        source: network-drive
        target: /app/network
        volume: {}
      - type: volume
        source: local-drive
        target: /app/data
        volume: {}
      - type: bind
        source: C:\Users\fhulufhelo\source\repos\SharedDriveAccess\SharedDriveAccess
        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\fhulufhelo\source\repos\SharedDriveAccess
        target: /src
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\fhulufhelo\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\TokenService.Proxy\linux-x64\net6.0
        target: /TokenService.Proxy
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\HotReloadProxy\linux-x64\net6.0
        target: /HotReloadProxy
        read_only: true
        bind:

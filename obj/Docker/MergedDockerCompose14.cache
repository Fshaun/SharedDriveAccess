name: dockercompose5182526447759952421
services:
  shareddriveaccess:
    build:
      context: C:\Users\fhulufhelo\source\repos\My Learning\SharedDriveAccess
      dockerfile: SharedDriveAccess/Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: SharedDriveAccess
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    image: shareddriveaccess
    labels:
      com.microsoft.visual-studio.project-name: SharedDriveAccess
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  "/app/SharedDriveAccess.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      default: null
    tty: true
    volumes:
      - type: volume
        source: network-drive
        target: /app/network
        volume: {}
      - type: volume
        source: local-drive
        target: /app/data
        volume: {}
      - type: bind
        source: C:\Users\fhulufhelo\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\linux-x64\net8.0
        target: /VSTools
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\HotReload
        target: /HotReloadAgent
        read_only: true
        bind:
          create_host_path: true
networks:
  default:
    name: dockercompose5182526447759952421_default
volumes:
  local-drive:
    name: dockercompose5182526447759952421_local-drive
    driver: local
    driver_opts:
      device: C:/Users/fhulufhelo/Documents/DockerTest
      o: bind
      type: none
  network-drive:
    name: dockercompose5182526447759952421_network-drive
    driver: local
    driver_opts:
      device: //192.168.102.12/General/DPD IT Dept/Shaun
      o: username=fhulufhelo,password=Windows123,domain=dpdlaser.msft
      type: cifs